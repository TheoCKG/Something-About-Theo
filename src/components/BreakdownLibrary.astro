---
import { breakdowns } from '../data/breakdowns';

const categories = ['全部', ...new Set(breakdowns.map((entry) => entry.category))];
---

<breakdown-library class="breakdown-library not-content">
	<header class="bd-intro">
		<div>
			<p class="bd-eyebrow"><span></span> FIELD NOTES / GAME DESIGN</p>
			<h1>拆开规则。<br /><span>看见体验。</span></h1>
			<p class="bd-lead">从玩家做出的每一次选择，追到它背后的设计。<br />关于战斗、空间、协作与叙事的 {breakdowns.length} 篇游戏拆解。</p>
		</div>
		<div class="bd-total" aria-label={`${breakdowns.length} 篇拆解，4 个研究方向`}>
			<strong>{String(breakdowns.length).padStart(2, '0')}</strong>
			<span>篇拆解 / 04 个研究方向</span>
		</div>
	</header>

	<div class="bd-tools">
		<div class="bd-filters" aria-label="按研究方向筛选">
			{categories.map((category, index) => (
				<button type="button" data-category={category} aria-pressed={index === 0}>
					{category}
					<span>{index === 0 ? breakdowns.length : breakdowns.filter((entry) => entry.category === category).length}</span>
				</button>
			))}
		</div>
		<label class="bd-search">
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 4.3 4.3" /></svg>
			<input type="search" placeholder="搜索游戏 / 设计问题" aria-label="搜索游戏或设计问题" />
		</label>
	</div>

	<div class="bd-list-heading">
		<p>THE COLLECTION <span>/ 研究档案</span></p>
		<p data-result-count aria-live="polite">{breakdowns.length} 篇</p>
	</div>

	<div class="bd-grid">
		{breakdowns.map((entry, index) => (
			<article class="bd-card" data-category={entry.category} data-search={`${entry.game} ${entry.title} ${entry.category} ${entry.summary}`.toLocaleLowerCase()}>
				<a href={`/blog/game-breakdown/${entry.slug}/`} aria-label={entry.title}>
					<div class:list={['bd-cover', entry.imageKind === 'screenshot' && 'is-screenshot']}>
						<span class="bd-index">{String(index + 1).padStart(2, '0')}</span>
						<img src={entry.image} alt={entry.imageAlt ?? `${entry.game}机制分析图预览`} loading="lazy" decoding="async" />
						<span class="bd-media-label">{entry.imageKind === 'screenshot' ? '官方商店截图' : '机制示意图'}</span>
						<span class="bd-open" aria-hidden="true">↗</span>
					</div>
					<div class="bd-card-copy">
						<p class="bd-category">{entry.category}</p>
						<h2>{entry.game}</h2>
						<p class="bd-summary">{entry.summary}</p>
						<p class="bd-card-footer"><span>机制 · 案例 · 设计取舍</span><span>阅读拆解 ↗</span></p>
					</div>
				</a>
			</article>
		))}
	</div>

	<div class="bd-empty" hidden>
		<p>没有找到对应的拆解。</p>
		<button type="button" data-reset>清除筛选，查看全部</button>
	</div>

	<footer class="bd-note">
		<span>READING NOTE</span>
		<p>资料整理截至 2026 年 9 月。各篇保留版本范围、案例性质与来源；机制图概括的是分析关系。部分文章包含剧情或 Boss 剧透，详见篇首。</p>
	</footer>
</breakdown-library>

<script>
	class BreakdownLibrary extends HTMLElement {
		connectedCallback() {
			const input = this.querySelector<HTMLInputElement>('input[type="search"]')!;
			const filters = this.querySelectorAll<HTMLButtonElement>('[data-category]:is(button)');
			const cards = this.querySelectorAll<HTMLElement>('.bd-card');
			const count = this.querySelector<HTMLElement>('[data-result-count]')!;
			const empty = this.querySelector<HTMLElement>('.bd-empty')!;
			let category = '全部';

			const update = () => {
				const query = input.value.trim().toLocaleLowerCase();
				let visible = 0;
				cards.forEach((card) => {
					card.hidden = !(category === '全部' || card.dataset.category === category) || !card.dataset.search!.includes(query);
					if (!card.hidden) visible++;
				});
				count.textContent = `${visible} 篇`;
				empty.hidden = visible > 0;
				filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.category === category)));
			};

			input.addEventListener('input', update);
			filters.forEach((button) => button.addEventListener('click', () => {
				category = button.dataset.category!;
				update();
			}));
			this.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', () => {
				input.value = '';
				category = '全部';
				update();
				input.focus();
			});
		}
	}

	if (!customElements.get('breakdown-library')) customElements.define('breakdown-library', BreakdownLibrary);
</script>

<style>
	.breakdown-library {
		--bd-bg: #0d0f0e;
		--bd-text: #eeeae1;
		--bd-muted: #a7ada2;
		--bd-line: #30342d;
		--bd-accent: #d7ff3f;
		display: block;
		color: var(--bd-text);
		background: var(--bd-bg);
		padding: 4rem 0 2rem;
	}
	.breakdown-library p, .breakdown-library h1, .breakdown-library h2 { margin: 0; }
	.bd-intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 3rem; padding-bottom: 3.5rem; }
	.bd-eyebrow { display: flex; align-items: center; gap: .7rem; font: 600 .7rem/1.4 'Bahnschrift', sans-serif; letter-spacing: .17em; color: var(--bd-accent); }
	.bd-eyebrow span { width: .45rem; height: .45rem; background: currentColor; }
	.bd-intro h1 { margin: 1.5rem 0 1.6rem; font-size: clamp(2.6rem, 5.5vw, 5rem); line-height: 1.12; letter-spacing: -.055em; font-weight: 800; }
	.bd-intro h1 span { color: var(--bd-accent); }
	.bd-lead { max-width: 36rem; color: var(--bd-muted); font-size: .98rem; line-height: 1.9; }
	.bd-total { flex: none; display: flex; flex-direction: column; align-items: flex-end; padding-bottom: .2rem; }
	.bd-total strong { color: var(--bd-text); font: 700 clamp(5rem, 10vw, 8.5rem)/.9 'Bahnschrift', sans-serif; letter-spacing: -.08em; }
	.bd-total span { margin-top: 1rem; color: var(--bd-muted); font-size: .72rem; letter-spacing: .08em; }
	.bd-tools { display: flex; flex-wrap: wrap; gap: 1.2rem; justify-content: space-between; align-items: center; padding: 1.4rem 0; border-block: 1px solid var(--bd-line); }
	.bd-filters { display: flex; flex-wrap: wrap; gap: .45rem; }
	.bd-filters button { display: flex; align-items: center; gap: .5rem; padding: .6rem .75rem; border: 1px solid transparent; color: var(--bd-muted); background: transparent; font: inherit; font-size: .8rem; cursor: pointer; }
	.bd-filters button span { font-size: .65rem; opacity: .7; }
	.bd-filters button[aria-pressed='true'] { color: var(--bd-bg); background: var(--bd-accent); }
	.bd-filters button:hover { border-color: var(--bd-accent); }
	.bd-search { display: flex; align-items: center; gap: .7rem; min-width: 13rem; padding: .6rem .8rem; border: 1px solid var(--bd-line); color: var(--bd-muted); }
	.bd-search svg { width: 1rem; height: 1rem; flex: none; stroke: currentColor; stroke-width: 1.5; }
	.bd-search input { width: 100%; min-width: 0; padding: 0; border: 0; outline: none; color: var(--bd-text); background: transparent; font: inherit; font-size: .8rem; }
	.bd-search input::placeholder { color: var(--bd-muted); }
	.bd-search:focus-within { border-color: var(--bd-accent); }
	.bd-list-heading { display: flex; justify-content: space-between; padding: 1.8rem 0 1.1rem; font: 500 .7rem/1.4 'Bahnschrift', sans-serif; letter-spacing: .1em; color: var(--bd-muted); }
	.bd-list-heading span { margin-left: .5rem; letter-spacing: 0; }
	.bd-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
	.bd-card { min-width: 0; border: 1px solid var(--bd-line); background: #141713; transition: border-color 180ms ease, transform 180ms ease; }
	.bd-card[hidden], .bd-empty[hidden] { display: none; }
	.bd-card:hover, .bd-card:focus-within { border-color: #788644; transform: translateY(-4px); }
	.bd-card a { height: 100%; display: flex; flex-direction: column; color: inherit; text-decoration: none; }
	.bd-cover { aspect-ratio: 16 / 9; position: relative; overflow: hidden; padding: 1.2rem 3.4rem; background: repeating-linear-gradient(135deg, transparent 0 17px, #242a201c 17px 18px), #1b2118; border-bottom: 1px solid var(--bd-line); }
	.bd-cover img { display: block; width: 100%; height: 100%; object-fit: contain; background: #fff; transition: transform 250ms ease; }
	.bd-cover.is-screenshot { padding: 0; }
	.bd-cover.is-screenshot img { object-fit: cover; }
	.bd-media-label { position: absolute; left: .75rem; bottom: .65rem; padding: .3rem .45rem; color: var(--bd-text); background: #0d0f0ecc; font-size: .58rem; letter-spacing: .06em; }
	.bd-cover.is-screenshot .bd-index { padding: .3rem .4rem; background: #0d0f0ecc; }
	.bd-card:hover .bd-cover img { transform: scale(1.025); }
	.bd-index { position: absolute; top: 1rem; left: 1rem; color: var(--bd-accent); font: .7rem/1 'Bahnschrift', sans-serif; }
	.bd-open { position: absolute; bottom: .7rem; right: 1rem; font-size: 1.4rem; color: var(--bd-accent); }
	.bd-card-copy { flex: 1; display: flex; flex-direction: column; padding: 1.3rem; }
	.bd-category { color: var(--bd-accent); font-size: .67rem; letter-spacing: .08em; }
	.bd-card h2 { margin: .65rem 0 .7rem; color: var(--bd-text); font-size: clamp(1.15rem, 1.55vw, 1.5rem); font-weight: 700; letter-spacing: -.025em; line-height: 1.4; }
	.bd-summary { color: var(--bd-muted); font-size: .85rem; line-height: 1.8; }
	.bd-card-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .6rem; margin-top: auto !important; padding-top: 1.5rem; color: #828c7a; font-size: .63rem; }
	.bd-card-footer span:last-child { color: var(--bd-text); }
	.bd-empty { padding: 4rem 1rem; text-align: center; color: var(--bd-muted); }
	.bd-empty button { margin-top: 1rem; padding: .6rem .8rem; border: 1px solid var(--bd-line); color: var(--bd-accent); background: transparent; font: inherit; cursor: pointer; }
	.bd-note { display: flex; gap: 2rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--bd-line); color: var(--bd-muted); }
	.bd-note > span { flex: none; font: .65rem/1.9 'Bahnschrift', sans-serif; letter-spacing: .08em; color: var(--bd-accent); }
	.bd-note p { max-width: 56rem; font-size: .75rem; line-height: 1.9; }
	.breakdown-library :is(a, button):focus-visible { outline: 2px solid var(--bd-accent); outline-offset: 4px; }
	@media (max-width: 900px) {
		.bd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.bd-total strong { font-size: 6rem; }
		.bd-search { flex: 1; }
	}
	@media (max-width: 560px) {
		.breakdown-library { padding-top: 2.5rem; }
		.bd-intro { align-items: flex-start; gap: 1rem; padding-bottom: 2rem; }
		.bd-intro h1 { font-size: 2.7rem; }
		.bd-total { display: none; }
		.bd-eyebrow { font-size: .62rem; }
		.bd-lead { font-size: .85rem; }
		.bd-filters { gap: .25rem; }
		.bd-filters button { padding: .6rem .55rem; font-size: .73rem; }
		.bd-grid { grid-template-columns: minmax(0, 1fr); }
		.bd-card-copy { padding: 1.15rem; }
		.bd-card h2 { font-size: 1.4rem; }
		.bd-note { flex-direction: column; gap: .6rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.bd-card, .bd-cover img { transition: none; }
		.bd-card:hover, .bd-card:focus-within, .bd-card:hover .bd-cover img { transform: none; }
	}
</style>
