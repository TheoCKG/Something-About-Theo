---
// 首页 = 四个一级栏目的预览，顺序与顶部导航一致：作品 → 游戏库 → 文章 → 关于。
// 每个区块只放最有代表性的几条，并给出进入完整栏目的入口；联系方式在全站页脚。
import CameraLab from './CameraLab.astro';
import GameCard from './games/GameCard.astro';
import WorkArt from './pages/WorkArt.astro';
import WritingIndex from './pages/WritingIndex.astro';
import { gameCards, getGameCard } from '../data/gameCards';
import { works, timeline, RESUME_HREF } from '../data/profile';

const english = Astro.url.pathname.startsWith('/en');
const lang = english ? 'en' : 'zh';
const localize = (path: string) => (english ? `/en${path}` : path);
const featured = ['sekiro', 'monster-hunter-world', 'god-of-war-2018', 'apex-legends', 'the-witcher-3', 'it-takes-two'].map((slug) => getGameCard(slug)).filter((g) => g !== undefined);
const featuredWork = works.filter((w) => w.featured);
const writtenCount = gameCards.filter((g) => g.written).length;
---

<div class="portfolio-home not-content">
	<section class="folio-hero" aria-labelledby="hero-heading">
		<div class="hero-copy">
			<p class="folio-kicker"><span class="signal-square"></span> THEO / COMBAT & TECHNICAL DESIGN</p>
			<h1 id="hero-heading">DESIGN<br />THE <span>FEEL.</span></h1>
			<p class="hero-statement">{english ? 'The weight of combat. The life in a system.' : '战斗的手感，系统的生命力。'}</p>
			<p class="hero-intro">{english ? 'I’m Wentao Zhang, a combat and technical designer exploring movement, abilities, and AI-driven characters.' : '我是张文韬 Theo，战斗与技术策划。关注角色移动、技能机制，以及能够感知、决策与行动的 AI NPC。'}</p>
			<div class="folio-actions">
				<a class="folio-button primary" href={localize('/work/')}>{english ? 'Explore my work' : '查看作品'} <span aria-hidden="true">↗</span></a>
				<a class="folio-text-link" href={RESUME_HREF} download>{english ? 'Download résumé' : '下载简历'} <span aria-hidden="true">↓</span></a>
			</div>
			<p class="hero-credits">{english ? 'Archosaur Games · AI NPC systems · Tsinghua IMDT' : '祖龙娱乐 · AI NPC 系统设计 · 清华 IMDT'}</p>
		</div>
		<div class="hero-lab"><CameraLab english={english} /></div>
		<div class="hero-bottom"><span>PLAYER EXPERIENCE, BY DESIGN.</span><a href="#work">{english ? 'SCROLL TO EXPLORE' : '向下探索'} ↓</a></div>
	</section>

	<section id="work" class="folio-section" aria-labelledby="work-heading">
		<div class="section-heading">
			<div><p class="folio-kicker">01 / {english ? 'WORK' : '作品'}</p><h2 id="work-heading">{english ? 'From rules to experience.' : '从规则，到体验。'}</h2></div>
			<a class="folio-text-link" href={localize('/work/')}>{english ? `All ${works.length} projects` : `全部 ${works.length} 个作品`} ↗</a>
		</div>
		<div class="work-grid">
			{featuredWork.map((w, i) => (
				<a class="work-card" href={localize(`/work/#${w.id}`)}>
					<WorkArt item={w} index={i} />
					<div class="work-caption"><p class="work-tags">{w.tags}</p><h3>{w.title[lang]} <span aria-hidden="true">↗</span></h3><p>{w.role[lang]}</p><span class="card-footer">{w.context[lang]}</span></div>
				</a>
			))}
		</div>
	</section>

	<section class="folio-section research-section" aria-labelledby="studies-heading">
		<div class="section-heading">
			<div><p class="folio-kicker">02 / {english ? 'GAME LIBRARY' : '游戏库'}</p><h2 id="studies-heading">{english ? 'Play. Question. Break it down.' : '拆开好游戏，理解好设计。'}</h2></div>
			<a class="folio-text-link" href="/blog/game-breakdown/">{english ? `${gameCards.length} games · ${writtenCount} studies · 中文` : `${gameCards.length} 款游戏 · ${writtenCount} 篇拆解`} ↗</a>
		</div>
		<div class="studies-cards">
			{featured.map((game, index) => <GameCard game={game} index={index} compact english={english} />)}
		</div>
	</section>

	<section class="folio-section research-section" aria-labelledby="writing-heading">
		<div class="section-heading">
			<div><p class="folio-kicker">03 / {english ? 'WRITING' : '文章'}</p><h2 id="writing-heading">{english ? 'Notes on design.' : '想清楚，再写下来。'}</h2></div>
			<a class="folio-text-link" href={localize('/blog/')}>{english ? 'All writing' : '全部文章'} ↗</a>
		</div>
		<WritingIndex compact limit={4} />
	</section>

	<section id="about" class="folio-section about-section" aria-labelledby="about-heading">
		<div class="about-intro"><p class="folio-kicker">04 / {english ? 'ABOUT' : '关于'}</p><h2 id="about-heading">{english ? 'Design it. Build it. Feel it.' : <>设计，然后<br />让它发生。</>}</h2><p>{english ? 'My work connects player experience with the systems behind it, from combat and movement to AI character behavior.' : '我的经历连接着体验设计与技术实现：从角色的一次起跳，到 NPC 对世界的一次回应。'}</p><a class="folio-text-link" href={localize('/about/')}>{english ? 'More about me' : '关于我'} ↗</a></div>
		<div class="experience-list">
			{timeline.map((item) => <div><span class="experience-year">{item.period}</span><div><h3>{item.org[lang]}</h3><p>{item.role[lang]}</p></div><span class="experience-code">{item.code}</span></div>)}
		</div>
	</section>
</div>
