---
// 全站外框。导航按履历顺序：教育 → 工作 → 游戏 → 项目 → 博客（见 src/data/site.ts）。
// 教育 / 工作 / 项目是首页锚点，游戏 / 博客是独立页面；落地页自己负责标题区，普通文章页由这里统一输出面包屑 + 标题。
import '../../styles/portfolio.css';
import GameArticleHeader from '../games/GameArticleHeader.astro';
import { getGameCard } from '../../data/gameCards';
import { NAV, WRITING_TYPES, isEnglishPath, isLanding, stripLocale } from '../../data/site';
import { RESUME_HREF, GITHUB_HREF } from '../../data/profile';

const route = Astro.locals.starlightRoute;
const isEnglish = isEnglishPath(Astro.url.pathname);
const path = stripLocale(Astro.url.pathname);
const landing = isLanding(Astro.url.pathname);
const isBreakdown = path.startsWith('/blog/game-breakdown/');
const game = isBreakdown ? getGameCard(path.split('/').pop()!) : undefined;
const writingType = !landing && !isBreakdown ? WRITING_TYPES.find((w) => path.startsWith('/' + w.dir + '/')) : undefined;
const homeHref = isEnglish ? '/en/' : '/';
const isHome = path === '/';
// 锚点栏目：在首页直接跳区块，在其他页面先回首页
const navHref = (item: (typeof NAV)[number]) =>
	item.anchor ? (isHome ? `#${item.anchor}` : `${homeHref}#${item.anchor}`) : item.zhOnly ? `${item.href}/` : localize(item.href!);
const localize = (href: string) => (isEnglish ? `/en${href}/` : `${href}/`);
const title = route?.entry?.data?.title ?? '';
const description = route?.entry?.data?.description ?? '';
const t = (zh: string, en: string) => (isEnglish ? en : zh);
// 语言切换：游戏库和拆解只有中文，切英文时回英文首页
const switchHref = isEnglish ? (path === '/' ? '/' : `${path}/`) : path === '/' || path.startsWith('/blog/') ? '/en/' : `/en${path}/`;
---

<div class="portfolio-shell">
	<div class="folio-progress" aria-hidden="true"></div>
	<header class="folio-header not-content">
		<a class="folio-logo" href={homeHref} aria-label={t('Theo 首页', 'Theo home')}><span class="folio-logo-mark" aria-hidden="true">t</span>THEO.</a>
		<nav aria-label={t('主导航', 'Main navigation')}>
			{NAV.map((item, i) => (
				<a href={navHref(item)} data-spy={isHome ? item.anchor ?? item.spy : undefined} aria-current={item.match?.(path) ? 'page' : undefined}>
					<span class="nav-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{t(item.zh, item.en)}{isEnglish && item.zhOnly && <small> · 中文</small>}
				</a>
			))}
		</nav>
		<div class="folio-header-tools"><a href={switchHref} aria-label={t('English version', '切换到中文')}>{t('EN', '中文')}</a><a class="folio-header-cv" href={RESUME_HREF} download>{t('简历', 'RÉSUMÉ')} ↓</a></div>
	</header>

	<main id="_top" class:list={['folio-main', !landing && 'is-article']}>
		{isBreakdown && <a class="article-breadcrumb" href="/blog/game-breakdown/">← {t('游戏库', 'Game library')}</a>}
		{game && <GameArticleHeader game={game} />}
		{!landing && !isBreakdown && (
			<header class="page-head not-content">
				<a class="article-breadcrumb" href={localize('/blog')}>← {t('博客', 'Blog')}{writingType && <span> / {t(writingType.zh, writingType.en)}</span>}</a>
				<h1 class="page-title">{title}</h1>
				{description && <p class="page-desc">{description}</p>}
			</header>
		)}
		<slot />
	</main>

	<footer class="folio-footer not-content">
		<section id="contact" class:list={['contact-band', !landing && 'is-slim']} aria-label={t('联系', 'Contact')}>
			<div><p class="folio-kicker">NEXT / LET’S CONNECT</p><p class="contact-title">LET’S MAKE<br />IT FEEL RIGHT.</p><p>{t('完整经历与联系方式，收录在我的简历中。', 'Find my experience and contact details in my résumé.')}</p></div>
			<div class="contact-actions"><a class="folio-button" href={RESUME_HREF} download>{t('下载简历', 'Download résumé')} ↓</a><a href={GITHUB_HREF} target="_blank" rel="noreferrer">GITHUB ↗</a></div>
		</section>
		<div class="footer-bar"><span>THEO / COMBAT & TECHNICAL DESIGN</span><a href="#_top">{t('回到顶部', 'Back to top')} ↑</a></div>
	</footer>
</div>

<script>
	// 滚动进场：首页各区块、作品条目、经历条目依次浮现（游戏小卡有自己的入场逻辑）
	if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const targets = document.querySelectorAll<HTMLElement>('.sec-head, .log-card, .module, .mini-stats, .writing-row, .contact-band, .is-article .resume-markdown > *:not(figure):not(details)');
		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				e.target.classList.add('is-revealed');
				io.unobserve(e.target);
			}
		}, { rootMargin: '0px 0px -6% 0px' });
		targets.forEach((el, i) => {
			if (el.getBoundingClientRect().top < innerHeight) return; // 首屏内容直接显示，不闪
			el.classList.add('reveal');
			el.style.setProperty('--d', `${(i % 3) * 70}ms`);
			io.observe(el);
		});
	}
</script>
