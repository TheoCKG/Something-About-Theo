---
// 关于页：一句话介绍 + 经历时间线（职业经历链接到作品页对应项目，细节只在作品页写一次）。
import { timeline } from '../../data/profile';
import { isEnglishPath } from '../../data/site';

const lang = isEnglishPath(Astro.url.pathname) ? 'en' : 'zh';
const en = lang === 'en';
const workHref = en ? '/en/work/' : '/work/';
---

<div class="landing not-content">
	<header class="landing-head about-head">
		<p class="folio-kicker"><span class="signal-square"></span>ABOUT / {en ? 'THE DESIGNER' : '关于'}</p>
		<h1>{en ? <>Design it.<br /><span>Make it happen.</span></> : <>设计，然后<br /><span>让它发生。</span></>}</h1>
		<p class="landing-lead">
			{en
				? "I'm Wentao Zhang (Theo), a combat and technical designer exploring movement, abilities, and AI-driven characters. My work connects player experience with the systems behind it."
				: '我是张文韬 Theo，战斗与技术策划。关注角色移动、技能机制，以及能够感知、决策与行动的 AI NPC。我的经历连接着体验设计与技术实现：从角色的一次起跳，到 NPC 对世界的一次回应。'}
		</p>
	</header>

	<section aria-labelledby="timeline-heading">
		<div class="section-heading"><div><p class="folio-kicker">TIMELINE</p><h2 id="timeline-heading">{en ? 'Experience' : '经历'}</h2></div></div>
		<div class="experience-list is-detailed">
			{timeline.map((item) => {
				const Tag = item.workId ? 'a' : 'div';
				return (
					<Tag href={item.workId ? `${workHref}#${item.workId}` : undefined}>
						<span class="experience-year">{item.period}</span>
						<div>
							<h3>{item.org[lang]}</h3>
							<p>{item.role[lang]}</p>
							{item.note && <p class="experience-note">{item.note[lang]}</p>}
						</div>
						<span class="experience-code">{item.workId ? (en ? 'SEE WORK ↗' : '查看项目 ↗') : item.code}</span>
					</Tag>
				);
			})}
		</div>
	</section>
</div>
