---
// 作品页：所有项目在一页，职业项目展开要点，课程/训练营项目给概要。
import WorkArt from './WorkArt.astro';
import { works } from '../../data/profile';
import { isEnglishPath } from '../../data/site';

const lang = isEnglishPath(Astro.url.pathname) ? 'en' : 'zh';
const en = lang === 'en';
---

<div class="landing not-content">
	<header class="landing-head">
		<p class="folio-kicker"><span class="signal-square"></span>WORK / {en ? 'PROJECTS' : '作品'}</p>
		<h1>{en ? <>From rules,<br />to <span>experience.</span></> : <>从规则，<br />到<span>体验。</span></>}</h1>
		<p class="landing-lead">{en ? 'Professional projects in combat, movement and AI characters, plus course and camp projects.' : '战斗、移动与 AI 角色方向的职业项目，以及课程和训练营中的作品。'}</p>
		<nav class="jump-list" aria-label={en ? 'Projects' : '项目目录'}>
			{works.map((w, i) => <a href={`#${w.id}`}><span>{String(i + 1).padStart(2, '0')}</span>{w.title[lang]}</a>)}
		</nav>
	</header>

	<div class="work-list">
		{works.map((w, i) => (
			<article class="work-row" id={w.id}>
				<WorkArt item={w} index={i} />
				<div class="work-body">
					<p class="work-tags">{w.kind[lang]} · {w.period}</p>
					<h2>{w.title[lang]}</h2>
					<p class="work-summary">{w.summary[lang]}</p>
					<dl class="work-facts">
						<div><dt>{en ? 'Context' : '背景'}</dt><dd>{w.context[lang]}</dd></div>
						<div><dt>{en ? 'My role' : '我的职责'}</dt><dd>{w.role[lang]}</dd></div>
						{w.honor && <div><dt>{en ? 'Recognition' : '荣誉'}</dt><dd class="is-honor">{w.honor[lang]}</dd></div>}
					</dl>
					{w.points[lang].length > 0 && (
						<ol class="work-points">{w.points[lang].map((p) => <li>{p}</li>)}</ol>
					)}
					<p class="work-tagline">{w.tags}</p>
				</div>
			</article>
		))}
	</div>
</div>
